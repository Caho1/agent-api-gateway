{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent API Gateway",
    "version": "0.3.0",
    "description": "Generic authenticated HTTPS API relay; server-side origins and credentials, scoped service/method/path grants. No provider business adapters."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787",
      "description": "Local gateway; production clients use configured HTTPS origin"
    }
  ],
  "paths": {
    "/v1/relay": {
      "post": {
        "operationId": "relay",
        "security": [
          {
            "gatewayBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Invocation"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Relayed response. Inspect data.status for upstream errors; no normalization.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, revoked or legacy bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Service/grant policy denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request quota or minute rate exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Unsafe/unavailable upstream or blocked credential echo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Local service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Upstream total deadline exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Local readiness with schemaVersion and release; no upstream call"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "gatewayBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Scoped gateway token; never the upstream credential"
      }
    },
    "schemas": {
      "Invocation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "method", "path"],
        "properties": {
          "service": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]{1,64}$"
          },
          "method": {
            "type": "string",
            "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
          },
          "path": {
            "type": "string",
            "maxLength": 8192,
            "description": "Canonical relative path; no URL, query, fragment, traversal or encoded separators"
          },
          "query": {
            "type": "object",
            "maxProperties": 100,
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "headers": {
            "type": "object",
            "maxProperties": 30,
            "additionalProperties": {
              "type": "string"
            },
            "description": "Only service-approved safe headers, never provider credentials"
          },
          "body": {},
          "bodyBase64": {
            "type": "string",
            "contentEncoding": "base64",
            "description": "Exact request bytes; mutually exclusive with body; GET/HEAD cannot carry body"
          }
        }
      },
      "UpstreamResponse": {
        "type": "object",
        "required": ["status", "headers", "encoding", "body"],
        "properties": {
          "status": {
            "type": "integer",
            "minimum": 200,
            "maximum": 599
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "encoding": {
            "enum": ["json", "base64"]
          },
          "body": {},
          "rawBodyBase64": {
            "type": "string",
            "contentEncoding": "base64",
            "description": "Exact original bytes for JSON, preserving large integer fidelity"
          }
        }
      },
      "Envelope": {
        "type": "object",
        "required": ["requestId", "data"],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/UpstreamResponse"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["requestId", "error"],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
