# Provider credentials are configured via the admin UI and saved only in GATEWAY_SECRETS.
GATEWAY_CONFIG=./config.json
GATEWAY_DB=./state/gateway.sqlite
GATEWAY_PORT=8787
GATEWAY_SECRETS=./state/provider-keys.json
ADMIN_PASSWORD_HASH_FILE=./state/admin-password.hash
ADMIN_ORIGIN=http://127.0.0.1:8787
